# ── 虚拟环境与工具目录 ──────────────────────────────────────
.venv/
.idea/
.claude/
.testhome/

# ── 构建产物 ────────────────────────────────────────────────
build/
dist/
*.spec
*.app/

# ── 运行时数据（程序会自动重建） ─────────────────────────────
data/

# ── Python 缓存 ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── 打包中间产物 ────────────────────────────────────────────
*.tar.xz
*.dmg
*.7z
*.zip

# ── 操作系统杂物 ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
